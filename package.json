{
  "name": "clinicavet-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "setup:demo": "node --env-file=.env.local --import tsx scripts/setup-demo.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node --import tsx scripts/test-e2e.ts",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"components/*.tsx\" \"lib/*.ts\" \"scripts/*.ts\" \"tests/*.ts\" README.md next.config.ts tailwind.config.ts eslint.config.mjs"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "motion": "^13.4.6",
    "mysql2": "^3.11.5",
    "next": "^16.3.7",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15"
  }
}
